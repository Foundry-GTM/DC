# --- Supabase ---
# Project URL + publishable key are public (NEXT_PUBLIC_*) and safe in the browser.
# (Supabase renamed these: anon key -> publishable key, service_role -> secret key.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client. Bypasses RLS — use with care.
SUPABASE_SECRET_KEY=

# --- Database (Drizzle / postgres.js) ---
# Use the Supabase transaction-mode pooler URL (port 6543). The client sets
# prepare:false to be pooler-safe.
DATABASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Resend (email) ---
RESEND_API_KEY=

# --- PostHog (analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Admin allowlist (Drew bypasses workspace boundary) ---
ADMIN_EMAILS=
